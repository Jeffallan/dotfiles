#!/usr/bin/env bash
#
# my-work — summarize your GitHub activity for a time window.
#
# Usage: my-work [--period SPEC] [--since DATE] [--until DATE]
#                [--user USERNAME] [--verbose]
#
#   --period SPEC   Named preset or rolling window:
#                     this-week   (default)  last-week
#                     this-month             last-month
#                     today
#                     Nd / Nw / Nm  (e.g. 7d, 2w, 1m)
#   --since DATE    ISO date (YYYY-MM-DD). Overrides --period start.
#   --until DATE    ISO date (YYYY-MM-DD). Overrides --period end.
#   --user USER     GitHub login. Default: `gh api user --jq .login`.
#   --verbose       Include up to 5 commit subjects per repo.
#   -h, --help      Show this message.
#
# Exits: 0 ok, 1 misuse, 2 gh missing, 3 gh not authenticated, 4 GitHub API error.

set -euo pipefail

PROG="${0##*/}"
IS_DARWIN=0
[[ "$(uname -s)" == "Darwin" ]] && IS_DARWIN=1

usage() {
    sed -n '2,20p' "$0" | sed 's/^# \{0,1\}//'
}

die() {
    printf '%s: %s\n' "$PROG" "$1" >&2
    exit "${2:-1}"
}

WARNINGS=0
warn() {
    printf '%s: warning: %s\n' "$PROG" "$1" >&2
    WARNINGS=1
}

# Format a UTC ISO-8601 timestamp from a date arithmetic spec.
# Accepts one of:
#   now                       — current time
#   today                     — today 00:00:00Z
#   monday-of-week            — Monday 00:00:00Z of current ISO week
#   monday-of-last-week       — Monday 00:00:00Z of prior ISO week
#   sunday-of-last-week-end   — Sunday 23:59:59Z of prior ISO week
#   first-of-month            — 1st of current month 00:00:00Z
#   first-of-last-month       — 1st of prior month 00:00:00Z
#   last-of-last-month-end    — last day of prior month 23:59:59Z
#   offset:Nd | offset:Nw | offset:Nm   — now minus N days/weeks/months
#   date-start:YYYY-MM-DD     — 00:00:00Z at given date
#   date-end:YYYY-MM-DD       — 23:59:59Z at given date
_iso() {
    local spec="$1"
    case "$spec" in
        now)
            if [[ $IS_DARWIN -eq 1 ]]; then
                date -u +%Y-%m-%dT%H:%M:%SZ
            else
                date -u +%Y-%m-%dT%H:%M:%SZ
            fi
            ;;
        today)
            date -u +%Y-%m-%dT00:00:00Z
            ;;
        monday-of-week)
            # ISO weekday: 1=Mon..7=Sun
            local dow offset
            dow=$(date -u +%u)
            offset=$((dow - 1))
            if [[ $IS_DARWIN -eq 1 ]]; then
                date -u -v-"${offset}"d +%Y-%m-%dT00:00:00Z
            else
                date -u -d "${offset} days ago" +%Y-%m-%dT00:00:00Z
            fi
            ;;
        monday-of-last-week)
            local dow offset
            dow=$(date -u +%u)
            offset=$((dow - 1 + 7))
            if [[ $IS_DARWIN -eq 1 ]]; then
                date -u -v-"${offset}"d +%Y-%m-%dT00:00:00Z
            else
                date -u -d "${offset} days ago" +%Y-%m-%dT00:00:00Z
            fi
            ;;
        sunday-of-last-week-end)
            local dow offset
            dow=$(date -u +%u)
            offset=$((dow - 1 + 1))
            if [[ $IS_DARWIN -eq 1 ]]; then
                date -u -v-"${offset}"d +%Y-%m-%dT23:59:59Z
            else
                date -u -d "${offset} days ago" +%Y-%m-%dT23:59:59Z
            fi
            ;;
        first-of-month)
            date -u +%Y-%m-01T00:00:00Z
            ;;
        first-of-last-month)
            if [[ $IS_DARWIN -eq 1 ]]; then
                date -u -v1d -v-1m +%Y-%m-01T00:00:00Z
            else
                date -u -d "$(date -u +%Y-%m-01) -1 month" +%Y-%m-01T00:00:00Z
            fi
            ;;
        last-of-last-month-end)
            if [[ $IS_DARWIN -eq 1 ]]; then
                date -u -v1d -v-1d +%Y-%m-%dT23:59:59Z
            else
                date -u -d "$(date -u +%Y-%m-01) -1 day" +%Y-%m-%dT23:59:59Z
            fi
            ;;
        offset:*)
            local rhs unit n flag
            rhs="${spec#offset:}"
            unit="${rhs: -1}"
            n="${rhs%?}"
            [[ "$n" =~ ^[0-9]+$ ]] || die "invalid offset: $rhs" 1
            case "$unit" in
                d) flag="d"; word="days" ;;
                w) flag="w"; word="weeks" ;;
                m) flag="m"; word="months" ;;
                *) die "invalid offset unit '$unit' in '$rhs' (use d/w/m)" 1 ;;
            esac
            if [[ $IS_DARWIN -eq 1 ]]; then
                date -u -v-"${n}${flag}" +%Y-%m-%dT%H:%M:%SZ
            else
                date -u -d "${n} ${word} ago" +%Y-%m-%dT%H:%M:%SZ
            fi
            ;;
        date-start:*)
            local d="${spec#date-start:}"
            [[ "$d" =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}$ ]] || die "invalid date: $d (want YYYY-MM-DD)" 1
            printf '%sT00:00:00Z\n' "$d"
            ;;
        date-end:*)
            local d="${spec#date-end:}"
            [[ "$d" =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}$ ]] || die "invalid date: $d (want YYYY-MM-DD)" 1
            printf '%sT23:59:59Z\n' "$d"
            ;;
        *)
            die "internal: unknown _iso spec '$spec'" 1
            ;;
    esac
}

resolve_period() {
    local period="$1"
    case "$period" in
        this-week)
            SINCE=$(_iso monday-of-week); UNTIL=$(_iso now) ;;
        last-week)
            SINCE=$(_iso monday-of-last-week); UNTIL=$(_iso sunday-of-last-week-end) ;;
        this-month)
            SINCE=$(_iso first-of-month); UNTIL=$(_iso now) ;;
        last-month)
            SINCE=$(_iso first-of-last-month); UNTIL=$(_iso last-of-last-month-end) ;;
        today)
            SINCE=$(_iso today); UNTIL=$(_iso now) ;;
        *[dwm])
            SINCE=$(_iso "offset:$period"); UNTIL=$(_iso now) ;;
        *)
            die "unknown --period '$period'" 1 ;;
    esac
}

# ---- argument parsing ----
PERIOD="this-week"
SINCE_OVERRIDE=""
UNTIL_OVERRIDE=""
USER_ARG=""
VERBOSE=0

while [[ $# -gt 0 ]]; do
    case "$1" in
        --period) [[ $# -ge 2 ]] || die "--period needs a value" 1; PERIOD="$2"; shift 2 ;;
        --since)  [[ $# -ge 2 ]] || die "--since needs a value" 1;  SINCE_OVERRIDE="$2"; shift 2 ;;
        --until)  [[ $# -ge 2 ]] || die "--until needs a value" 1;  UNTIL_OVERRIDE="$2"; shift 2 ;;
        --user)   [[ $# -ge 2 ]] || die "--user needs a value" 1;   USER_ARG="$2"; shift 2 ;;
        --verbose) VERBOSE=1; shift ;;
        -h|--help) usage; exit 0 ;;
        *) die "unknown argument: $1 (try --help)" 1 ;;
    esac
done

# ---- preflight ----
command -v gh >/dev/null 2>&1 || die "gh CLI not found (https://cli.github.com)" 2
gh auth status >/dev/null 2>&1 || die "gh not authenticated (run: gh auth login)" 3

if [[ -z "$USER_ARG" ]]; then
    USER_ARG=$(gh api user --jq '.login')
fi

resolve_period "$PERIOD"
LABEL="$PERIOD"
if [[ -n "$SINCE_OVERRIDE" ]]; then
    SINCE=$(_iso "date-start:$SINCE_OVERRIDE")
    LABEL="custom range"
fi
if [[ -n "$UNTIL_OVERRIDE" ]]; then
    UNTIL=$(_iso "date-end:$UNTIL_OVERRIDE")
    LABEL="custom range"
fi

SINCE_DATE="${SINCE%%T*}"
UNTIL_DATE="${UNTIL%%T*}"

# ---- fetch events, determine touched repos + per-type counts ----
#
# Output lines: "<repo>\t<event_type>\t<payload.action or empty>"
EVENTS=$(gh api "/users/${USER_ARG}/events" --paginate --jq \
    ".[] | select(.created_at >= \"${SINCE}\" and .created_at <= \"${UNTIL}\") | \"\(.repo.name)\t\(.type)\t\(.payload.action // \"\")\"" \
    2>/dev/null || true)

# Collect unique repos (preserve order of first appearance).
REPOS=()
if [[ -n "$EVENTS" ]]; then
    while IFS=$'\t' read -r repo _type; do
        [[ -z "$repo" ]] && continue
        seen=0
        if [[ ${#REPOS[@]} -gt 0 ]]; then
            for r in "${REPOS[@]}"; do
                [[ "$r" == "$repo" ]] && seen=1 && break
            done
        fi
        [[ $seen -eq 0 ]] && REPOS+=("$repo")
    done <<< "$EVENTS"
fi

# ---- header ----
printf 'Your %s (%s → %s) as %s\n\n' "$LABEL" "$SINCE_DATE" "$UNTIL_DATE" "$USER_ARG"

if [[ ${#REPOS[@]} -eq 0 ]]; then
    echo "No public activity in this window."
    exit 0
fi

# count_events_for <repo> <type>
count_events_for() {
    local repo="$1" typ="$2"
    printf '%s\n' "$EVENTS" | awk -F'\t' -v r="$repo" -v t="$typ" '$1==r && $2==t' | wc -l | tr -d ' '
}

# count_events_for_action <repo> <type> <action>
count_events_for_action() {
    local repo="$1" typ="$2" action="$3"
    printf '%s\n' "$EVENTS" | awk -F'\t' -v r="$repo" -v t="$typ" -v a="$action" '$1==r && $2==t && $3==a' | wc -l | tr -d ' '
}

# gh_search <args...> — run `gh search <args...>` into SEARCH_OUT. If it fails
# because the search quota (~30/min) is used up, wait for the reset and retry
# once. Returns non-zero if the search still fails.
gh_search() {
    local quota remaining reset wait
    SEARCH_OUT=$(gh search "$@" 2>/dev/null) && return 0
    quota=$(gh api rate_limit --jq '.resources.search | "\(.remaining) \(.reset)"' 2>/dev/null) || return 1
    remaining="${quota%% *}"; reset="${quota##* }"
    [[ "$remaining" == 0 && "$reset" =~ ^[0-9]+$ ]] || return 1
    wait=$(( reset - $(date +%s) + 1 ))
    (( wait < 1 )) && wait=1
    (( wait > 61 )) && wait=61
    printf '%s: search rate limit reached, waiting %ss\n' "$PROG" "$wait" >&2
    sleep "$wait"
    SEARCH_OUT=$(gh search "$@" 2>/dev/null)
}

# ---- per-repo counts ----
# A count that can't be fetched shows as "?" and is left out of the totals.
OWNERS=(); NAMES=(); COMMITS=(); PRS=(); ISSUES=(); RELEASES=(); SUBJECTS=()
TOTAL_COMMITS=0; TOTAL_PRS=0; TOTAL_ISSUES=0; TOTAL_RELEASES=0

for repo in "${REPOS[@]}"; do
    # Authored commits on any branch in the window, via commit search. Lines are
    # "<sha>\t<subject>", newest first; search can repeat a commit, so dedupe by SHA.
    # The first five subjects double as the --verbose list.
    commits="?"; subjects=""
    if gh_search commits --author="$USER_ARG" --repo="$repo" \
        --author-date="${SINCE}..${UNTIL}" --sort author-date --limit 1000 \
        --json sha,commit --jq '.[] | [.sha, (.commit.message | split("\n")[0])] | @tsv'; then
        found=$(printf '%s\n' "$SEARCH_OUT" | awk -F'\t' 'NF && !seen[$1]++')
        commits=$(printf '%s' "$found" | awk 'END {print NR}')
        if [[ $VERBOSE -eq 1 && "$commits" -gt 0 ]]; then
            subjects=$(printf '%s\n' "$found" | awk -F'\t' 'NR <= 5 {print "      - " $2}')
        fi
    else
        warn "$repo: could not count commits"
    fi

    # PRs the user authored in the repo that were merged inside the window.
    prs_merged="?"
    if gh_search prs --author="$USER_ARG" --repo="$repo" \
        --merged-at="${SINCE}..${UNTIL}" --limit 1000 \
        --json number --jq 'length'; then
        prs_merged="${SEARCH_OUT:-0}"
    else
        warn "$repo: could not count merged PRs"
    fi

    # Issues opened by the user in the repo+window (from events feed).
    issues=$(count_events_for_action "$repo" IssuesEvent opened)

    # Releases cut by the user in the repo+window (from events feed).
    releases=$(count_events_for "$repo" ReleaseEvent)

    OWNERS+=("${repo%%/*}"); NAMES+=("${repo#*/}")
    COMMITS+=("$commits"); PRS+=("$prs_merged"); ISSUES+=("$issues"); RELEASES+=("$releases")
    SUBJECTS+=("$subjects")
    if [[ "$commits" != "?" ]]; then
        TOTAL_COMMITS=$((TOTAL_COMMITS + commits))
    fi
    if [[ "$prs_merged" != "?" ]]; then
        TOTAL_PRS=$((TOTAL_PRS + prs_merged))
    fi
    TOTAL_ISSUES=$((TOTAL_ISSUES + issues))
    TOTAL_RELEASES=$((TOTAL_RELEASES + releases))
done

# ---- table ----
if [[ ${#REPOS[@]} -eq 1 ]]; then
    REPO_COUNT="1 repo"
else
    REPO_COUNT="${#REPOS[@]} repos"
fi

# Column widths: widest of header, total row, and every repo row.
W_OWNER=5; W_NAME=${#REPO_COUNT}
(( W_NAME < 4 )) && W_NAME=4
for i in "${!OWNERS[@]}"; do
    (( ${#OWNERS[i]} > W_OWNER )) && W_OWNER=${#OWNERS[i]}
    (( ${#NAMES[i]} > W_NAME )) && W_NAME=${#NAMES[i]}
done
W_COMMITS=$(( ${#TOTAL_COMMITS} > 7 ? ${#TOTAL_COMMITS} : 7 ))
W_PRS=$(( ${#TOTAL_PRS} > 3 ? ${#TOTAL_PRS} : 3 ))
W_ISSUES=$(( ${#TOTAL_ISSUES} > 6 ? ${#TOTAL_ISSUES} : 6 ))
W_RELEASES=$(( ${#TOTAL_RELEASES} > 8 ? ${#TOTAL_RELEASES} : 8 ))

print_row() {
    printf '  %-*s  %-*s  %*s  %*s  %*s  %*s\n' \
        "$W_OWNER" "$1" "$W_NAME" "$2" "$W_COMMITS" "$3" "$W_PRS" "$4" "$W_ISSUES" "$5" \
        "$W_RELEASES" "$6"
}

print_row OWNER REPO COMMITS PRs ISSUES RELEASES
for i in "${!OWNERS[@]}"; do
    print_row "${OWNERS[i]}" "${NAMES[i]}" "${COMMITS[i]}" "${PRS[i]}" "${ISSUES[i]}" "${RELEASES[i]}"
    [[ -n "${SUBJECTS[i]}" ]] && printf '%s\n' "${SUBJECTS[i]}"
done
RULE_WIDTH=$(( W_OWNER + W_NAME + W_COMMITS + W_PRS + W_ISSUES + W_RELEASES + 10 ))
printf '  %s\n' "$(printf '%*s' "$RULE_WIDTH" '' | tr ' ' '-')"
print_row Total "$REPO_COUNT" "$TOTAL_COMMITS" "$TOTAL_PRS" "$TOTAL_ISSUES" "$TOTAL_RELEASES"

if [[ $WARNINGS -eq 1 ]]; then
    exit 4
fi
