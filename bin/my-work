#!/usr/bin/env bash
#
# my-work — summarize your GitHub activity for a time window.
#
# Usage: my-work [--period SPEC] [--since DATE] [--until DATE]
#                [--user USERNAME] [--verbose]
#
#   --period SPEC   Named preset or rolling window:
#                     this-week   (default)  last-week
#                     this-month             last-month
#                     today
#                     Nd / Nw / Nm  (e.g. 7d, 2w, 1m)
#   --since DATE    Local date (YYYY-MM-DD). Overrides --period start.
#   --until DATE    Local date (YYYY-MM-DD). Overrides --period end.
#   --user USER     GitHub login. Default: `gh api user --jq .login`.
#   --verbose       Include up to 5 commit subjects per repo.
#   -h, --help      Show this message.
#
# Exits: 0 ok, 1 misuse, 2 gh missing, 3 gh not authenticated, 4 GitHub API error.

set -euo pipefail

PROG="${0##*/}"
IS_DARWIN=0
[[ "$(uname -s)" == "Darwin" ]] && IS_DARWIN=1

usage() {
    sed -n '2,20p' "$0" | sed 's/^# \{0,1\}//'
}

die() {
    printf '%s: %s\n' "$PROG" "$1" >&2
    exit "${2:-1}"
}

WARNINGS=0
warn() {
    printf '%s: warning: %s\n' "$PROG" "$1" >&2
    WARNINGS=1
}

# Window boundaries are local calendar days; the API wants UTC. Everything is
# carried as epoch seconds and only formatted at the end.

# _epoch_of_local DATE TIME — epoch of a local wall-clock time. Dies unless
# DATE is a real YYYY-MM-DD calendar date.
_epoch_of_local() {
    local d="$1" t="$2" epoch back=""
    [[ "$d" =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}$ ]] || die "invalid date: $d (want YYYY-MM-DD)" 1
    if [[ $IS_DARWIN -eq 1 ]]; then
        epoch=$(date -j -f '%Y-%m-%d %H:%M:%S' "$d $t" +%s 2>/dev/null) || epoch=""
    else
        epoch=$(date -d "$d $t" +%s 2>/dev/null) || epoch=""
    fi
    # BSD date rolls 2026-02-30 over to March instead of failing; the
    # round trip catches that on both platforms.
    [[ -n "$epoch" ]] && back=$(_local_ymd "$epoch")
    [[ "$back" == "$d" ]] || die "invalid date: $d (want YYYY-MM-DD)" 1
    printf '%s\n' "$epoch"
}

# _local_ymd EPOCH — local calendar date (YYYY-MM-DD) of EPOCH.
_local_ymd() {
    if [[ $IS_DARWIN -eq 1 ]]; then
        date -r "$1" +%Y-%m-%d
    else
        date -d "@$1" +%Y-%m-%d
    fi
}

# _utc_iso EPOCH — UTC ISO-8601 timestamp of EPOCH.
_utc_iso() {
    if [[ $IS_DARWIN -eq 1 ]]; then
        date -u -r "$1" +%Y-%m-%dT%H:%M:%SZ
    else
        date -u -d "@$1" +%Y-%m-%dT%H:%M:%SZ
    fi
}

# _days_ago N — local calendar date N days before today.
_days_ago() {
    if [[ $IS_DARWIN -eq 1 ]]; then
        date -v-"$1"d +%Y-%m-%d
    else
        # Anchor at noon so a DST shift can't push the result across midnight.
        date -d "$(date +%Y-%m-%d) 12:00 $1 days ago" +%Y-%m-%d
    fi
}

# _offset_epoch Nd|Nw|Nm — epoch of now minus N days/weeks/months.
_offset_epoch() {
    local rhs="$1" unit n flag word
    unit="${rhs: -1}"
    n="${rhs%?}"
    [[ "$n" =~ ^[0-9]+$ ]] || die "invalid offset: $rhs" 1
    case "$unit" in
        d) flag="d"; word="days" ;;
        w) flag="w"; word="weeks" ;;
        m) flag="m"; word="months" ;;
        *) die "invalid offset unit '$unit' in '$rhs' (use d/w/m)" 1 ;;
    esac
    if [[ $IS_DARWIN -eq 1 ]]; then
        date -v-"${n}${flag}" +%s
    else
        date -d "${n} ${word} ago" +%s
    fi
}

# Sets SINCE_EPOCH and UNTIL_EPOCH. Named periods start and end at local
# midnights, and the ISO weekday is the local one (1=Mon..7=Sun).
resolve_period() {
    local period="$1" dow first lfirst llast
    dow=$(date +%u)
    first=$(date +%Y-%m-01)
    case "$period" in
        this-week)
            SINCE_EPOCH=$(_epoch_of_local "$(_days_ago $((dow - 1)))" 00:00:00)
            UNTIL_EPOCH=$(date +%s) ;;
        last-week)
            SINCE_EPOCH=$(_epoch_of_local "$(_days_ago $((dow + 6)))" 00:00:00)
            UNTIL_EPOCH=$(_epoch_of_local "$(_days_ago "$dow")" 23:59:59) ;;
        this-month)
            SINCE_EPOCH=$(_epoch_of_local "$first" 00:00:00)
            UNTIL_EPOCH=$(date +%s) ;;
        last-month)
            if [[ $IS_DARWIN -eq 1 ]]; then
                lfirst=$(date -v1d -v-1m +%Y-%m-01)
                llast=$(date -v1d -v-1d +%Y-%m-%d)
            else
                lfirst=$(date -d "$first 12:00 1 month ago" +%Y-%m-01)
                llast=$(date -d "$first 12:00 1 day ago" +%Y-%m-%d)
            fi
            SINCE_EPOCH=$(_epoch_of_local "$lfirst" 00:00:00)
            UNTIL_EPOCH=$(_epoch_of_local "$llast" 23:59:59) ;;
        today)
            SINCE_EPOCH=$(_epoch_of_local "$(date +%Y-%m-%d)" 00:00:00)
            UNTIL_EPOCH=$(date +%s) ;;
        *[dwm])
            SINCE_EPOCH=$(_offset_epoch "$period")
            UNTIL_EPOCH=$(date +%s) ;;
        *)
            die "unknown --period '$period'" 1 ;;
    esac
}

# ---- argument parsing ----
PERIOD="this-week"
SINCE_OVERRIDE=""
UNTIL_OVERRIDE=""
USER_ARG=""
VERBOSE=0

while [[ $# -gt 0 ]]; do
    case "$1" in
        --period) [[ $# -ge 2 ]] || die "--period needs a value" 1; PERIOD="$2"; shift 2 ;;
        --since)  [[ $# -ge 2 ]] || die "--since needs a value" 1;  SINCE_OVERRIDE="$2"; shift 2 ;;
        --until)  [[ $# -ge 2 ]] || die "--until needs a value" 1;  UNTIL_OVERRIDE="$2"; shift 2 ;;
        --user)   [[ $# -ge 2 ]] || die "--user needs a value" 1;   USER_ARG="$2"; shift 2 ;;
        --verbose) VERBOSE=1; shift ;;
        -h|--help) usage; exit 0 ;;
        *) die "unknown argument: $1 (try --help)" 1 ;;
    esac
done

# ---- preflight ----
command -v gh >/dev/null 2>&1 || die "gh CLI not found (https://cli.github.com)" 2
gh auth status >/dev/null 2>&1 || die "gh not authenticated (run: gh auth login)" 3

if [[ -z "$USER_ARG" ]]; then
    USER_ARG=$(gh api user --jq '.login')
fi

resolve_period "$PERIOD"
LABEL="$PERIOD"
if [[ -n "$SINCE_OVERRIDE" ]]; then
    SINCE_EPOCH=$(_epoch_of_local "$SINCE_OVERRIDE" 00:00:00)
    LABEL="custom range"
fi
if [[ -n "$UNTIL_OVERRIDE" ]]; then
    UNTIL_EPOCH=$(_epoch_of_local "$UNTIL_OVERRIDE" 23:59:59)
    LABEL="custom range"
fi
(( SINCE_EPOCH <= UNTIL_EPOCH )) || \
    die "window start $(_local_ymd "$SINCE_EPOCH") is after its end $(_local_ymd "$UNTIL_EPOCH")" 1

SINCE=$(_utc_iso "$SINCE_EPOCH")
UNTIL=$(_utc_iso "$UNTIL_EPOCH")
SINCE_DATE=$(_local_ymd "$SINCE_EPOCH")
UNTIL_DATE=$(_local_ymd "$UNTIL_EPOCH")

# ---- fetch events, determine touched repos + per-type counts ----
#
# Fetch the whole feed unfiltered so we can tell whether it reaches back to SINCE.
# Raw lines: "<created_at>\t<repo>\t<event_type>\t<payload.action or empty>"
GH_ERR=$(mktemp)
trap 'rm -f "$GH_ERR"' EXIT
RAW_EVENTS=$(gh api "/users/${USER_ARG}/events" --paginate --jq \
    '.[] | "\(.created_at)\t\(.repo.name)\t\(.type)\t\(.payload.action // "")"' \
    2>"$GH_ERR") || die "fetching events failed: $(tr '\n' ' ' < "$GH_ERR")" 4

# GitHub caps the feed (300 events, limited lookback); warn if it stops short of SINCE.
OLDEST_EVENT=$(printf '%s\n' "$RAW_EVENTS" | awk -F'\t' 'NF && (o == "" || $1 < o) {o = $1} END {print o}')
if [[ -n "$OLDEST_EVENT" && "$OLDEST_EVENT" > "$SINCE" ]]; then
    warn "events feed only reaches back to ${OLDEST_EVENT} (GitHub caps it at 300 events and a limited lookback); repos touched only before then are missing"
fi

# Output lines: "<repo>\t<event_type>\t<payload.action or empty>"
EVENTS=$(printf '%s\n' "$RAW_EVENTS" | awk -F'\t' -v s="$SINCE" -v u="$UNTIL" \
    'NF && $1 >= s && $1 <= u {print $2 "\t" $3 "\t" $4}')

# Collect unique repos (preserve order of first appearance).
REPOS=()
if [[ -n "$EVENTS" ]]; then
    while IFS=$'\t' read -r repo _type; do
        [[ -z "$repo" ]] && continue
        seen=0
        if [[ ${#REPOS[@]} -gt 0 ]]; then
            for r in "${REPOS[@]}"; do
                [[ "$r" == "$repo" ]] && seen=1 && break
            done
        fi
        [[ $seen -eq 0 ]] && REPOS+=("$repo")
    done <<< "$EVENTS"
fi

# ---- header ----
printf 'Your %s (%s → %s) as %s\n\n' "$LABEL" "$SINCE_DATE" "$UNTIL_DATE" "$USER_ARG"

if [[ ${#REPOS[@]} -eq 0 ]]; then
    echo "No activity found in the events feed for this window."
    [[ $WARNINGS -eq 1 ]] && exit 4
    exit 0
fi

# count_events_for <repo> <type>
count_events_for() {
    local repo="$1" typ="$2"
    printf '%s\n' "$EVENTS" | awk -F'\t' -v r="$repo" -v t="$typ" '$1==r && $2==t' | wc -l | tr -d ' '
}

# count_events_for_action <repo> <type> <action>
count_events_for_action() {
    local repo="$1" typ="$2" action="$3"
    printf '%s\n' "$EVENTS" | awk -F'\t' -v r="$repo" -v t="$typ" -v a="$action" '$1==r && $2==t && $3==a' | wc -l | tr -d ' '
}

# ---- per-repo counts ----
OWNERS=(); NAMES=(); COMMITS=(); PRS=(); ISSUES=(); RELEASES=(); SUBJECTS=()
TOTAL_COMMITS=0; TOTAL_PRS=0; TOTAL_ISSUES=0; TOTAL_RELEASES=0

for repo in "${REPOS[@]}"; do
    # Authored commits in window (counts all commits where user is GitHub author).
    # A repo that errors (deleted, no access, empty) counts as 0 instead of aborting.
    commits=$(gh api "repos/${repo}/commits?author=${USER_ARG}&since=${SINCE}&until=${UNTIL}" \
        --paginate --jq 'length' 2>/dev/null | awk '{s+=$1} END {print s+0}') || true

    # PRs the user authored in the repo that were merged inside the window.
    prs_merged=$(gh search prs --author="$USER_ARG" --repo="$repo" \
        --merged-at="${SINCE_DATE}..${UNTIL_DATE}" --limit 1000 \
        --json number --jq 'length' 2>/dev/null || echo 0)

    # Issues opened by the user in the repo+window (from events feed).
    issues=$(count_events_for_action "$repo" IssuesEvent opened)

    # Releases cut by the user in the repo+window (from events feed).
    releases=$(count_events_for "$repo" ReleaseEvent)

    subjects=""
    if [[ $VERBOSE -eq 1 && "$commits" -gt 0 ]]; then
        subjects=$(gh api "repos/${repo}/commits?author=${USER_ARG}&since=${SINCE}&until=${UNTIL}" \
            --jq '.[] | "      - " + (.commit.message | split("\n")[0])' 2>/dev/null | head -n 5) || true
    fi

    OWNERS+=("${repo%%/*}"); NAMES+=("${repo#*/}")
    COMMITS+=("$commits"); PRS+=("$prs_merged"); ISSUES+=("$issues"); RELEASES+=("$releases")
    SUBJECTS+=("$subjects")
    TOTAL_COMMITS=$((TOTAL_COMMITS + commits))
    TOTAL_PRS=$((TOTAL_PRS + prs_merged))
    TOTAL_ISSUES=$((TOTAL_ISSUES + issues))
    TOTAL_RELEASES=$((TOTAL_RELEASES + releases))
done

# ---- table ----
if [[ ${#REPOS[@]} -eq 1 ]]; then
    REPO_COUNT="1 repo"
else
    REPO_COUNT="${#REPOS[@]} repos"
fi

# Column widths: widest of header, total row, and every repo row.
W_OWNER=5; W_NAME=${#REPO_COUNT}
(( W_NAME < 4 )) && W_NAME=4
for i in "${!OWNERS[@]}"; do
    (( ${#OWNERS[i]} > W_OWNER )) && W_OWNER=${#OWNERS[i]}
    (( ${#NAMES[i]} > W_NAME )) && W_NAME=${#NAMES[i]}
done
W_COMMITS=$(( ${#TOTAL_COMMITS} > 7 ? ${#TOTAL_COMMITS} : 7 ))
W_PRS=$(( ${#TOTAL_PRS} > 3 ? ${#TOTAL_PRS} : 3 ))
W_ISSUES=$(( ${#TOTAL_ISSUES} > 6 ? ${#TOTAL_ISSUES} : 6 ))
W_RELEASES=$(( ${#TOTAL_RELEASES} > 8 ? ${#TOTAL_RELEASES} : 8 ))

print_row() {
    printf '  %-*s  %-*s  %*s  %*s  %*s  %*s\n' \
        "$W_OWNER" "$1" "$W_NAME" "$2" "$W_COMMITS" "$3" "$W_PRS" "$4" "$W_ISSUES" "$5" \
        "$W_RELEASES" "$6"
}

print_row OWNER REPO COMMITS PRs ISSUES RELEASES
for i in "${!OWNERS[@]}"; do
    print_row "${OWNERS[i]}" "${NAMES[i]}" "${COMMITS[i]}" "${PRS[i]}" "${ISSUES[i]}" "${RELEASES[i]}"
    [[ -n "${SUBJECTS[i]}" ]] && printf '%s\n' "${SUBJECTS[i]}"
done
RULE_WIDTH=$(( W_OWNER + W_NAME + W_COMMITS + W_PRS + W_ISSUES + W_RELEASES + 10 ))
printf '  %s\n' "$(printf '%*s' "$RULE_WIDTH" '' | tr ' ' '-')"
print_row Total "$REPO_COUNT" "$TOTAL_COMMITS" "$TOTAL_PRS" "$TOTAL_ISSUES" "$TOTAL_RELEASES"

if [[ $WARNINGS -eq 1 ]]; then
    exit 4
fi
